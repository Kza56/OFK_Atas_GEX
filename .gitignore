# .NET build artifacts
**/bin/
**/obj/

# Python environments, bytecode, and test caches
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Local environment configuration and secrets
.env
.env.*
!.env.example
!**/.env.example

# Pipeline runtime data (large, generated, or machine-specific)
OFK_GEX_Pipeline/data/*.json
OFK_GEX_Pipeline/data/*.pdf
OFK_GEX_Pipeline/data/*.txt
OFK_GEX_Pipeline/data/history/
OFK_GEX_Pipeline/data/backups/
OFK_GEX_Pipeline/data/logs/
OFK_GEX_Pipeline/logs/

# Keep committed examples
!OFK_GEX_Pipeline/data/samples/
!OFK_GEX_Pipeline/data/samples/**

# IDE / OS
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*.sln
