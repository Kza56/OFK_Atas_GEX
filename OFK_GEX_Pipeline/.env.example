# OFK GEX Pipeline environment overrides
#
# The Python process reads these values from its environment. This example is
# intentionally not loaded by the application, so secrets cannot be picked up
# accidentally. Copy it to a local file and export the values in your shell,
# or use a tool such as direnv.

# Redirect generated JSON, briefing, PDF, and history files.
# GEX_DATA_DIR=/Users/your-name/market-data/ofk-gex

# Codex CLI executable. The default is "codex" on PATH.
CODEX_CMD=codex

# Maximum seconds for one read-only Codex briefing invocation.
CODEX_TIMEOUT_SECONDS=180

# Optional per-file output overrides.
# NQ_GEX_JSON=/path/to/NQ_gex_latest.json
# ES_GEX_JSON=/path/to/ES_gex_latest.json
# NQ_LEVELS_JSON=/path/to/levels_NQ.json
# ES_LEVELS_JSON=/path/to/levels_ES.json
# NQ_FULL_JSON=/path/to/full_levels_NQ.json
# ES_FULL_JSON=/path/to/full_levels_ES.json

# Optional retention overrides.
# GEX_HISTORY_MAX_DAYS=380
# GEX_INTRADAY_HISTORY_MAX_DAYS=7
