<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ATAS X currently runs on .NET 10 on the development Mac. Keep this
         value aligned with OFT.PlatformX.runtimeconfig.json. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>OFK_Atas_X_Probe</AssemblyName>
    <RootNamespace>OFK_GEX.Probe</RootNamespace>
    <Version>0.1.0</Version>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Override with ATAS_X_PATH or -p:ATASXPath=... when ATAS X is installed
       somewhere other than the default macOS application bundle. -->
  <PropertyGroup>
    <ATASXPath Condition="'$(ATASXPath)' == ''">$(ATAS_X_PATH)</ATASXPath>
    <ATASXPath Condition="'$(ATASXPath)' == ''">/Applications/ATAS X.app/Contents/MonoBundle</ATASXPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(ATASXPath)/ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(ATASXPath)/ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.Types">
      <HintPath>$(ATASXPath)/ATAS.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Core">
      <HintPath>$(ATASXPath)/OFT.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>$(ATASXPath)/OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(ATASXPath)/OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="OFK_Atas_X_Probe.cs" />
  </ItemGroup>

</Project>
